urn savedUser ? JSON.parse(savedUser) : null;\n    } catch (error) {\n      localStorage.removeItem(\"tc_user\");\n      return null;\n    }\n  });\n\n  const [token, setToken] = useState(\n    () => localStorage.getItem(\"tc_token\") || null\n  );\n\n  useEffect(() => {\n    if (token) {\n      localStorage.setItem(\"tc_token\", token);\n    } else {\n      localStorage.removeItem(\"tc_token\");\n    }\n  }, [token]);\n\n  useEffect(() => {\n    if (user) {\n      localStorage.setItem(\n        \"tc_user\",\n        JSON.stringify(user)\n      );\n    } else {\n      localStorage.removeItem(\"tc_user\");\n    }\n  }, [user]);\n\n  const login = (userData, jwt) => {\n    setUser(userData);\n    setToken(jwt);\n  };\n\n  const updateUser = (userData) => {\n    setUser(userData);\n  };\n\n  const logout = () => {\n    setUser(null);\n    setToken(null);\n\n    localStorage.removeItem(\"tc_token\");\n    localStorage.removeItem(\"tc_user\");\n  };\n\n  return (\n    <AuthContext.Provider\n      value={{\n        user,\n        token,\n        login,\n        logout,\n        updateUser,\n        isAuthenticated: Boolean(token),\n      }}\n    >\n      {children}\n    </AuthContext.Provider>\n  );\n};\n\nexport const useAuth = () => useContext(AuthContext);"],"mappings":"AAAA,MAAO,CAAAA,KAAK,EACVC,aAAa,CACbC,UAAU,CACVC,SAAS,CACTC,QAAQ,KACH,OAAO,CAAC,OAAAC,GAAA,IAAAC,IAAA,yBAEf,KAAM,CAAAC,WAAW,cAAGN,aAAa,CAAC,IAAI,CAAC,CAEvC,MAAO,MAAM,CAAAO,YAAY,CAAGC,IAAA,EAAkB,IAAjB,CAAEC,QAAS,CAAC,CAAAD,IAAA,CACvC,KAAM,CAACE,IAAI,CAAEC,OAAO,CAAC,CAAGR,QAAQ,CAAC,IAAM,CACrC,KAAM,CAAAS,SAAS,CAAGC,YAAY,CAACC,OAAO,CAAC,SAAS,CAAC,CAEjD,GAAI,CACF,MAAO,CAAAF,SAAS,CAAGG,IAAI,CAACC,KAAK,CAACJ,SAAS,CAAC,CAAG,IAAI,CACjD,CAAE,MAAOK,KAAK,CAAE,CACdJ,YAAY,CAACK,UAAU,CAAC,SAAS,CAAC,CAClC,MAAO,KAAI,CACb,CACF,CAAC,CAAC,CAEF,KAAM,CAACC,KAAK,CAAEC,QAAQ,CAAC,CAAGjB,QAAQ,CAChC,IAAMU,YAAY,CAACC,OAAO,CAAC,UAAU,CAAC,EAAI,IAC5C,CAAC,CAEDZ,SAAS,CAAC,IAAM,CACd,GAAIiB,KAAK,CAAE,CACTN,YAAY,CAACQ,OAAO,CAAC,UAAU,CAAE